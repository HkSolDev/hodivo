# Disabled until you configure Google locally. Never paste credentials into chat.
AUTH_ENABLED=false
# Passkeys require localhost (not 127.0.0.1); use this exact origin in the browser.
# Google redirect URI: http://localhost:8080/api/auth/callback/google
BETTER_AUTH_URL=http://localhost:8080
# Frontend runtime: exact public origin for job canonical links and share previews.
# Set to the public HTTPS origin in production (never the internal API URL).
SITE_URL=http://localhost:8080
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Manual/cron extraction launcher; choose a free-tier project in AI Studio.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
# Auxiliary Gemini task models, each independent of LLM_MODEL (never inherited);
# unset entries default to gemini-3.8-flash.
GEMINI_SEARCH_MODEL=
GEMINI_REVIEW_MODEL=
GEMINI_VISION_MODEL=
# Independent auxiliary providers: gemini (default), xai or deepseek.
# For xai, set each task MODEL explicitly, e.g. grok-4.7.
SEARCH_PROVIDER=gemini
SEARCH_MODEL=
REVIEW_PROVIDER=gemini
REVIEW_MODEL=
VISION_PROVIDER=gemini
VISION_MODEL=
# For xAI extraction: LLM_PROVIDER=xai and LLM_MODEL=grok-4.7.
XAI_API_KEY=
# Ordered comma-separated list of Gemini API keys; trimmed and deduplicated without logging.
# Vision/enrichment rotates once per key only on HTTP 429 / RESOURCE_EXHAUSTED.
GEMINI_API_KEYS=
# Compatible single/comma-separated or numbered fallbacks (GEMINI_API_KEY_1, _2, etc.):
GEMINI_API_KEY=
# Alternative: set LLM_PROVIDER=deepseek and LLM_MODEL=deepseek-flash.
DEEPSEEK_API_KEY=
# DeepSeek auxiliary tasks (Responses API):
# SEARCH_PROVIDER=deepseek; SEARCH_MODEL=deepseek-v4-pro (native web search)
# REVIEW_PROVIDER=deepseek; REVIEW_MODEL=deepseek-flash
# VISION_PROVIDER=deepseek; VISION_MODEL=deepseek-flash
# Flash ignores the Responses web_search tool; do not use it as SEARCH_MODEL.
# With DeepSeek: defer peak-hour startup and requests, with a five-minute margin.
# Production cron launches --once at 04:00, 10:00, 16:00 and 22:00 IST.
DEEPSEEK_OFF_PEAK_ONLY=true

# Optional: Next.js jobs-cache revalidation endpoint, notified after publication commits
FRONTEND_REVALIDATE_URL=

# Optional: read-only slave-db + Redis Stream sync queue
SLAVE_DATABASE_URL=
SYNC_REDIS_URL=
